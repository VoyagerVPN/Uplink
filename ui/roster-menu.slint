import { Action, CopyFeedback } from "controls.slint";
import { NetworkUi } from "network.slint";

export component RosterMenuAction inherits Action {
    height: 29px;
    leading-icon: true;
    align-start: true;
}

export component RosterMenuDivider inherits Rectangle {
    height: 7px;
    Rectangle { x: 5px; width: parent.width - 10px; height: 1px; background: #383b40; }
}

export component NetworkActions inherits Rectangle {
    in property <string> network-key;
    in property <string> server;
    in property <bool> can-invite;
    in property <bool> can-show-password;
    private property <bool> has-invitations: root.can-invite && (NetworkUi.link-on || NetworkUi.qr-on || (NetworkUi.password-on && root.can-show-password));
    callback copy(string) -> bool;
    callback leave();

    width: 24px;
    open := Action {
        width: parent.width; height: 26px;
        icon-only: true; borderless-focus: true; glyph-size: 16px;
        glyph: @image-url("../assets/icon/more.svg"); caption: @tr("Network actions");
        invoked => { menu.show(); }
    }
    menu := PopupWindow {
        close-policy: close-on-click-outside;
        x: parent.width - self.width; y: parent.height - 2px; width: 255px;
        height: actions.preferred-height;
        Rectangle {
            background: #25272b; border-width: 1px; border-color: #43474b; border-radius: 6px;
            actions := VerticalLayout {
                padding: 4px;
                RosterMenuAction {
                            width: parent.width;
                    caption: @tr("Copy network address");
                    glyph: address-receipt.active ? (address-receipt.success ? @image-url("../assets/icon/check.svg") : @image-url("../assets/icon/copy-error.svg")) : @image-url("../assets/icon/copy.svg");
                    glyph-color: address-receipt.active ? (address-receipt.success ? #bfec70 : #e99087) : #c8cdd3;
                    invoked => { address-receipt.show(root.copy(root.server)); }
                    address-receipt := CopyFeedback {}
                }
                if root.has-invitations: RosterMenuDivider {}
                if root.can-invite && NetworkUi.link-on: RosterMenuAction {
                            width: parent.width;
                    caption: @tr("Copy invitation link");
                    glyph: link-receipt.active ? (link-receipt.success ? @image-url("../assets/icon/check.svg") : @image-url("../assets/icon/copy-error.svg")) : @image-url("../assets/icon/link.svg");
                    glyph-color: link-receipt.active && !link-receipt.success ? #e99087 : #bfec70;
                    available: !NetworkUi.copying-link;
                    invoked => { NetworkUi.copy-invitation(); }
                    link-receipt := CopyFeedback {
                        property <int> serial: NetworkUi.copy-result;
                        changed serial => { self.show(NetworkUi.copied-link); }
                    }
                }
                if root.can-invite && root.can-show-password && NetworkUi.password-on: RosterMenuAction {
                            width: parent.width;
                    caption: @tr("Show login and password"); glyph: @image-url("../assets/icon/key.svg");
                    glyph-color: #bfec70;
                    invoked => { menu.close(); NetworkUi.show-invite("password"); }
                }
                if root.can-invite && NetworkUi.qr-on: RosterMenuAction {
                            width: parent.width;
                    caption: @tr("Show QR code"); glyph: @image-url("../assets/icon/qr.svg");
                    glyph-color: #bfec70;
                    invoked => { menu.close(); NetworkUi.show-invite("qr"); }
                }
                RosterMenuDivider {}
                if NetworkUi.manages: RosterMenuAction {
                            width: parent.width;
                    caption: @tr("Network settings"); glyph: @image-url("../assets/icon/settings.svg");
                    invoked => { menu.close(); NetworkUi.panel = "general"; NetworkUi.error = ""; }
                }
                RosterMenuAction {
                            width: parent.width;
                    caption: @tr("Leave network"); glyph: @image-url("../assets/icon/leave.svg"); danger: true;
                    invoked => { menu.close(); root.leave(); }
                }
            }
        }
    }
    changed network-key => { menu.close(); }
}
