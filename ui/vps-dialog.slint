import { DialogFrame, DialogActions, DialogButton, DialogError, DialogStep, Label, Action } from "controls.slint";
import { Tab, AvatarTile, NetworkUi } from "network.slint";
import { TextField } from "text-field.slint";

export global VpsUi {
    in-out property <int> step;
    in-out property <string> failure;
    in-out property <string> invitation;
    in-out property <string> network-key;
    in-out property <string> upgrade-result;
    in-out property <string> upgrade-log;
    pure callback check(string, string) -> string;
    callback has-upgrade-access(string) -> bool;
    callback choose-key(string) -> string;
    callback install(string,string,string,string,string,string,string,string,string);
    callback upgrade(string);
    callback upgrade-with-access(string,string,string,string,string,string);
}
component FieldError inherits Label {
    height: 16px;
    font-size: 12px;
    color: #e99087;
    overflow: elide;
}
component Field inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    in property <bool> secret;
    in property <bool> eye;
    in property <bool> clearable:true;
    in property <bool> show-error:true;
    callback toggle-eye();
    in property <string> error;
    in-out property <string> value <=> input.text;
    callback accept();
    in property <int> focus-cycle;
    changed focus-cycle => {if root.focus-cycle>0 {input.focus();}}
    spacing: 3px;
    Label {text:root.title; font-weight:600;}
    input := TextField {clearable:root.clearable;field-name:root.title;hint:root.hint;secret:root.secret;trailing:root.eye?26px:0px;submit(s)=>{root.accept();}
        if root.eye:Action {x:parent.width - 29px;y:2px;width:26px;height:28px;title-button:true;icon-only:true;glyph:root.secret?@image-url("../assets/icon/eye.svg"):@image-url("../assets/icon/eye-off.svg");
            accessible-label:root.secret?@tr("Show password"):@tr("Hide password");invoked=>{root.toggle-eye();}}
    }
    if root.show-error: FieldError {text:root.error;}
}
export component VpsDialog inherits DialogFrame {
    in property <bool> created-network-selected;
    in property <string> upgrade-host;
    in property <bool> saved-access;
    in property <int> server-revision;
    in property <int> bundled-server-revision;
    in property <string> suggested-ip;
    callback closed();
    callback copy-link(string)->bool;
    in-out property <string> page:root.upgrading?"confirm":"name";
    property <bool> checking;
    property <bool> is-key;
    property <string> name;
    property <string> ip:root.suggested-ip;
    property <string> port:"22";
    property <string> user;
    property <string> password;
    property <string> identity;
    property <bool> proxy;
    property <string> proxy-host;
    property <string> proxy-bind;
    property <string> udp-port:"9993";
    property <bool> reveal;
    property <bool> help;
    property <string> field-issue;
    property <int> attempt;
    private property <bool> manual-upgrade;
    private property <bool> upgrading:root.upgrade-host!="";
    private property <bool> busy:page=="progress" && (root.upgrading?VpsUi.upgrade-result=="":VpsUi.failure=="" && VpsUi.invitation=="");
    changed busy => { if root.upgrading && root.page=="progress" { root.focus(); } }
    title: root.page=="access"?@tr("VPS access"):root.upgrading?@tr("Update server"):VpsUi.invitation!=""?@tr("Network created"):@tr("Create network");
    show-back: root.page=="access" || (root.page=="confirm" && !root.upgrading);
    show-close: !root.busy;
    back => { root.go(root.upgrading ? "confirm" : root.page == "confirm" ? "access" : "name"); }
    dismiss => {if !root.busy {root.closed();}}
    function go(p:string) {root.checking=false; root.page=p; root.field-issue="";}
    function start-upgrade(enter-access:bool) {
        root.manual-upgrade=enter-access;
        VpsUi.failure=""; VpsUi.upgrade-result=""; VpsUi.upgrade-log=""; VpsUi.step=1;
        root.go("progress");
        if enter-access {
            VpsUi.upgrade-with-access(root.upgrade-host,root.ip,root.port,root.user,root.is-key?"":root.password,root.is-key?root.identity:"");
            root.password="";
            root.reveal=false;
        } else {
            VpsUi.upgrade(root.upgrade-host);
        }
    }
    function next() {
        root.checking=true;root.attempt+=1;
        if root.page=="name" {
            if VpsUi.check("name",root.name)=="" {root.go("access");} else {root.field-issue="name";}
        } else if root.page=="access" {
            if VpsUi.check("ip",root.ip)!="" {root.field-issue="ip";}
            else if VpsUi.check("port",root.port)!="" {root.field-issue="port";}
            else if VpsUi.check("user",root.user)!="" {root.field-issue="user";}
            else if root.is-key && root.identity=="" {root.checking=true;}
            else if !root.is-key && root.password=="" {root.field-issue="password";}
            else if root.upgrading {root.start-upgrade(true);}
            else {root.go("confirm");}
        } else if root.page=="confirm" || (root.page=="progress" && VpsUi.failure!="") {
            if root.upgrading {
                if root.saved-access {root.start-upgrade(false);}
                else {root.go("access");}
                return;
            }
            if root.proxy && VpsUi.check("proxy_host",root.proxy-host)!="" {root.field-issue="proxy_host";return;}
            if root.proxy && VpsUi.check("proxy_bind",root.proxy-bind)!="" {root.field-issue="proxy_bind";return;}
            if root.proxy && VpsUi.check("port",root.udp-port)!="" {root.field-issue="udp_port";return;}
            VpsUi.failure=""; VpsUi.invitation=""; VpsUi.step=1;
            root.go("progress");
            VpsUi.install(root.name,root.ip,root.port,root.user,root.is-key?"":root.password,root.is-key?root.identity:"",root.proxy?root.proxy-host:"",root.proxy?root.proxy-bind:"",root.proxy?root.udp-port:"");
        }
    }
    if root.page=="name": Field {focus-cycle:root.field-issue=="name"?root.attempt:0;title:@tr("Network name");value<=>root.name;error:root.checking?VpsUi.check("name",root.name):"";accept=>{root.next();}}
    if root.page=="name": Label {text:@tr("Use the server address and login from your hosting provider.");wrap:word-wrap;color:#a7abb2;}
    if root.page=="access" && root.upgrading: Label {text:root.upgrade-host;color:#a7abb2;overflow:elide;}
    if root.page=="access":VerticalLayout {spacing:3px;
        HorizontalLayout {spacing:8px;
            Field {show-error:false;focus-cycle:root.field-issue=="ip"?root.attempt:0;title:@tr("Server IP address");hint:"192.0.2.10";value<=>root.ip;accept=>{root.next();}}
            Field {show-error:false;focus-cycle:root.field-issue=="port"?root.attempt:0;clearable:false;width:78px;title:@tr("SSH port");value<=>root.port;accept=>{root.next();}}
        }
        FieldError {text:!root.checking?"":VpsUi.check("ip",root.ip)!=""?VpsUi.check("ip",root.ip):VpsUi.check("port",root.port);}
    }
    if root.page=="access":Field {focus-cycle:root.field-issue=="user"?root.attempt:0;title:@tr("Login");hint:"root";value<=>root.user;error:root.checking?VpsUi.check("user",root.user):"";accept=>{root.next();}}
    if root.page=="access":HorizontalLayout {height:28px;
        Tab {title:@tr("Password");selected:!root.is-key;choose=>{root.is-key=false;}}
        Tab {title:@tr("SSH key");selected:root.is-key;choose=>{root.is-key=true;}}
    }
    if root.page=="access" && !root.is-key:HorizontalLayout {spacing:4px;
        Field {focus-cycle:root.field-issue=="password"?root.attempt:0;title:@tr("VPS password");eye:true;secret:!root.reveal;toggle-eye=>{root.reveal=!root.reveal;}value<=>root.password;
            error:root.checking && root.password==""?@tr("Enter the VPS password."):"";accept=>{root.next();}}

    }
    if root.page=="access" && root.is-key:VerticalLayout {spacing:3px;
        Label {text:@tr("SSH key");font-weight:600;}
        DialogButton {caption:root.identity==""?@tr("Choose SSH key"):root.identity;invoked=>{root.identity=VpsUi.choose-key(root.identity);}}
        FieldError {text:root.checking && root.identity==""?@tr("Choose your private key file."):"";}
    }
    if root.page=="access": DialogButton {caption:@tr("Only have an IP and login?");invoked=>{root.help=!root.help;}}
    if root.page=="access" && root.help:Label {text:@tr("Open the access section in your VPS dashboard to set a password or choose a key.");wrap:word-wrap;color:#a7abb2;}
    if root.page=="confirm" && root.upgrading:VerticalLayout {spacing:8px;
        Label {text:root.upgrade-host;font-size:16px;font-weight:600;wrap:char-wrap;}
        HorizontalLayout {alignment:start;spacing:8px;
            Label {color:#a7abb2;text:root.server-revision>0?"v" + root.server-revision:"—";
                accessible-label:root.server-revision>0?self.text:@tr("Server version unknown");}
            if root.server-revision<root.bundled-server-revision:Label {color:#a7abb2;text:"→";}
            if root.server-revision<root.bundled-server-revision:Label {color:#bfec70;font-weight:600;text:"v" + root.bundled-server-revision;}
        }
        if root.server-revision<=root.bundled-server-revision:Label {text:@tr("All networks on this VPS will briefly disconnect.");wrap:word-wrap;}
        if root.server-revision>root.bundled-server-revision:Label {text:@tr("This server is already running a newer version");wrap:word-wrap;}
        if !root.saved-access && root.server-revision<=root.bundled-server-revision:Label {text:@tr("Set up SSH access once on this PC to update this server.");wrap:word-wrap;color:#a7abb2;}
    }
    if root.page=="confirm" && !root.upgrading:VerticalLayout {spacing:8px;
        Label {text:root.name;font-size:16px;font-weight:600;}
        Label {text:root.ip;color:#a7abb2;}
        Label {text:@tr("Uplink will install the server, create the network and connect you as its owner.");wrap:word-wrap;}
    }
    if root.page=="confirm" && !root.upgrading:DialogButton {caption:(root.proxy?"✓  ":"")+@tr("Use a hosting provider’s HTTPS proxy");invoked=>{root.proxy=!root.proxy;root.checking=false;}}
    if root.page=="confirm" && !root.upgrading && root.proxy:VerticalLayout {spacing:6px;
        Field {focus-cycle:root.field-issue=="proxy_host"?root.attempt:0;title:@tr("HTTPS proxy hostname");value<=>root.proxy-host;error:root.checking?VpsUi.check("proxy_host",root.proxy-host):"";accept=>{root.next();}}
        HorizontalLayout {spacing:8px;
            Field {show-error:false;focus-cycle:root.field-issue=="proxy_bind"?root.attempt:0;title:@tr("Private VPS address");value<=>root.proxy-bind;accept=>{root.next();}}
            Field {show-error:false;width:100px;clearable:false;focus-cycle:root.field-issue=="udp_port"?root.attempt:0;title:@tr("Public UDP port");value<=>root.udp-port;accept=>{root.next();}}
        }
        FieldError {text:!root.checking?"":VpsUi.check("proxy_bind",root.proxy-bind)!=""?VpsUi.check("proxy_bind",root.proxy-bind):VpsUi.check("port",root.udp-port);}
    }
    if root.page!="progress":DialogButton {width:root.card-width - 34px;primary:true;
        available:!root.upgrading || root.page!="confirm" || root.server-revision<=root.bundled-server-revision;
        caption:root.upgrading?(root.page=="access"?@tr("Save and update"):root.saved-access?@tr("Update server"):@tr("Set up SSH access")):
            root.page=="confirm"?@tr("Install and create network"):@tr("Continue");invoked=>{root.next();}}
    if root.page=="progress" && !root.upgrading && VpsUi.invitation=="":VerticalLayout {spacing:7px;
        for label[i] in [@tr("Verify SSH access"),@tr("Set up the server and network"),@tr("Connect this PC"),@tr("Assign owner and get invitation")]: DialogStep {
            caption: label;
            current: i + 1 == VpsUi.step;
            complete: i + 1 < VpsUi.step;
            failure: VpsUi.failure;
        }
    }
    if root.page=="progress" && !root.upgrading && VpsUi.failure!="":DialogActions {
        DialogButton {caption:@tr("Back");invoked=>{VpsUi.failure="";root.go("access");}}
        DialogButton {caption:@tr("Retry");primary:true;invoked=>{root.next();}}
    }
    if root.page=="progress" && root.upgrading && root.busy:VerticalLayout {spacing:7px;
        if VpsUi.step==6: DialogStep {caption:@tr("Restore previous server");current:true;}
        if VpsUi.step!=6: VerticalLayout {spacing:7px;
            for label[i] in [@tr("Verify SSH access"),@tr("Check the server"),@tr("Back up networks"),@tr("Install server update"),@tr("Check the updated server")]: DialogStep {
                caption:label;current:i+1==VpsUi.step;complete:i+1<VpsUi.step;
            }
        }
    }
    if root.page=="progress" && root.upgrading && !root.busy:VerticalLayout {spacing:8px;
        Label {font-size:16px;font-weight:600;wrap:word-wrap;
            text:VpsUi.upgrade-result=="updated"?@tr("Server updated"):
                 VpsUi.upgrade-result=="current"?@tr("Server is up to date"):
                 VpsUi.upgrade-result=="restored"?@tr("Previous server restored"):
                 VpsUi.upgrade-result=="restore_failed"?@tr("Server recovery needs attention"):
                 VpsUi.upgrade-result=="interrupted"?@tr("Server update status unknown"):@tr("Could not update server");}
        if VpsUi.upgrade-result=="interrupted":Label {text:@tr("Reconnect to check the update or recover the server.");wrap:word-wrap;}
        if VpsUi.failure!="":DialogError {text:VpsUi.failure;}
        if VpsUi.upgrade-log!="":DialogButton {caption:log-copied.running?"✓":@tr("Copy update log");invoked=>{if root.copy-link(VpsUi.upgrade-log){log-copied.start();}}}
        log-copied := Timer {interval:2s;running:false;triggered=>{self.stop();}}
        DialogActions {
            if VpsUi.upgrade-result=="updated" || VpsUi.upgrade-result=="current":DialogButton {primary:true;caption:@tr("Done");invoked=>{root.closed();}}
            if VpsUi.upgrade-result!="updated" && VpsUi.upgrade-result!="current":DialogButton {
                primary:true;caption:root.manual-upgrade?@tr("Back"):@tr("Retry");
                invoked=>{if root.manual-upgrade {root.go("access");} else {root.start-upgrade(false);}}
            }
            if VpsUi.upgrade-result=="failed" && VpsUi.step==1 && !root.manual-upgrade:DialogButton {
                caption:@tr("Set up SSH access");invoked=>{root.go("access");}}
        }
    }
    if root.page=="progress" && VpsUi.invitation!="":VerticalLayout {spacing:8px;
        HorizontalLayout {height:84px;spacing:12px;
            if root.created-network-selected: AvatarTile {empty-placeholder:true;}
            VerticalLayout {alignment:start;
                Label {height:64px;text:root.name;font-size:18px;font-weight:600;wrap:word-wrap;}
            }
        }
        if root.created-network-selected && NetworkUi.error!="":DialogError {text:NetworkUi.error;}
        Label {text:@tr("Send this invitation to a friend.");}
        TextField {text:VpsUi.invitation;readonly:true;field-name:@tr("Invitation");}
        DialogButton {width:root.card-width - 34px;primary:true;caption:copied.running?"✓":@tr("Copy invitation");invoked=>{if root.copy-link(VpsUi.invitation){copied.start();}}}
        copied := Timer {interval:2s;running:false;triggered=>{self.stop();}}
    }
}
