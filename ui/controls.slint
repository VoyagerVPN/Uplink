import { ButtonStyle } from "button-style.slint";
import { TextField } from "text-field.slint";

export component Label inherits Text {
    color: #eff0f2;
    font-size: 13px;
    vertical-alignment: center;
    overflow: elide;
}
export component HintCard inherits Rectangle {
    in property <string> message;
    background: #303338; border-radius: 6px;
    border-color: #494e54; border-width: 1px;
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; padding-top: 6px; padding-bottom: 6px;
        Text { text: root.message; color: #eff0f2; font-size: 12px; }
    }
}
export component ButtonFocus inherits FocusScope {
    private property <bool> pointer-focused;
    out property <bool> show-focus: self.has-focus && !self.pointer-focused;
    public function focus-from-pointer() {
        self.focus();
        self.pointer-focused = true;
    }
    changed has-focus => { if !self.has-focus { self.pointer-focused = false; } }
}

export component Action inherits Rectangle {
    in property <string> caption;
    in property <bool> available:true;
    accessible-enabled:root.available;
    opacity:root.available?1:0.55;
    private property <bool> hide-tip;
    private property <bool> hovered:touch.has-hover;
    changed hovered=>{if !root.hovered{root.hide-tip=false;}}
    in property <length> caption-inset: 0px;
    in property <bool> filled;
    in property <color> hover-background: ButtonStyle.hover-background;
    in property <bool> borderless-focus;
    in property <bool> selected;
    in property <color> selected-label-color: #bfec70;
    in property <bool> title-button;
    in property <bool> icon-only;
    in property <image> glyph;
    in property <length> glyph-size: 16px;
    in property <color> glyph-color: transparent;
    callback invoked();
    out property <bool> keyboard-focus-visible: keys.show-focus;
    public function focus-default(show-outline: bool) {
        if show-outline { keys.focus(); }
        else { keys.focus-from-pointer(); }
    }
    accessible-role: button;
    accessible-label: caption;
    accessible-action-default => {if root.available{root.invoked();}}
    width: word.preferred-width + 22px + (leading-icon?20px:0px);
    horizontal-stretch: 0;
    height: 30px;
    border-radius: 6px;
    background: primary && danger ? (touch.has-hover ? #ff9a91 : #ed8178) : primary?(touch.has-hover?#cef685:#bfec70):borderless-focus?transparent:touch.has-hover ? root.hover-background : (filled ? #25272b : transparent);
    border-width: borderless-focus ? 0px : 1px;
    border-color: keys.show-focus ? #8c929a : transparent;
    in property <bool> leading-icon;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> align-start;
    if leading-icon:Image{x:root.align-start?8px:10px;width:15px;height:15px;source:root.glyph;colorize:root.primary?#263415:root.glyph-color!=transparent?root.glyph-color:root.danger?#f2a099:#c8cdd3;}
    in property <angle> glyph-rotation;
    if icon-only: Image { width: root.glyph-size; height: root.glyph-size; image-fit: contain; source: root.glyph; transform-rotation: root.glyph-rotation; opacity: touch.pressed ? 0.7 : 1; colorize: root.glyph-color; }
    word := Label {
        visible: !root.icon-only; text: root.caption;
        x: root.leading-icon?(root.align-start?29px:20px):root.align-start?10px:root.caption-inset;
        width: root.width - self.x - (root.caption-inset > 0px ? 26px : 0px);
        horizontal-alignment: root.caption-inset > 0px || root.align-start ? left : center;
        color: root.danger && root.primary ? #341010 : root.danger?#f2a099:root.primary?#263415:touch.has-hover?#ffffff:root.selected?root.selected-label-color:#e1e3e6;
        font-size: root.title-button ? 19px : 12px;
    }
    if icon-only && !root.hide-tip: Tooltip { HintCard { message: root.caption; } }
    keys := ButtonFocus {
        enabled:root.available;
        key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.invoked(); return accept; } return reject; }
    }
    touch := TouchArea {
        enabled:root.available;
        mouse-cursor: pointer;
        pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { keys.focus-from-pointer(); } }
        clicked => {root.hide-tip=true;root.invoked();}
    }
}
export component EditableTitle inherits Rectangle {
    in property <string> value;
    in property <string> field-name;
    in property <string> action-label;
    in property <bool> editable: true;
    in property <bool> show-pencil;
    in property <bool> settings-control;
    in property <length> type-size: 16px;
    in-out property <bool> editing;
    callback changed-mode();
    callback save(string);
    height: 32px;
    function begin-edit() {
        if root.editable {
            root.changed-mode();
            root.editing = true;
            field.start(root.value);
        }
    }
    if !root.editing: Rectangle {
        name := Label {
            x: root.settings-control ? 12px : 0px;
            width: min(self.preferred-width, parent.width - self.x - (root.editable ? 28px : 0px));
            height: parent.height; horizontal-alignment: left;
            text: root.value; font-size: root.type-size; font-weight: root.settings-control ? 400 : 600;
            name-hover := TouchArea { x: 0px; width: name.width; }
        }
        if root.editable: pencil := ButtonFocus {
            x: root.settings-control ? 0px : name.width; width: root.settings-control ? parent.width : 28px; height: parent.height;
            accessible-role: button; accessible-label: root.action-label + " " + root.value;
            accessible-action-default => { root.begin-edit(); }
            key-pressed(event) => {
                if event.text == Key.Return || event.text == " " { root.begin-edit(); return accept; }
                return reject;
            }
            if pencil.show-focus: Rectangle {
                border-radius: 6px; border-width: 1px; border-color: #8c929a;
                background: pencil-hover.has-hover ? transparent : ButtonStyle.hover-background;
            }
            Image {
                visible: root.show-pencil || name-hover.has-hover || pencil-hover.has-hover || pencil.show-focus;
                x: root.settings-control ? parent.width - 23px : (parent.width - self.width) / 2;
                width: 15px; height: 15px; source: @image-url("../assets/icon/pencil.svg");
            }
            pencil-hover := TouchArea {
                mouse-cursor: pointer;
                pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { pencil.focus-from-pointer(); } }
                clicked => { root.begin-edit(); }
            }
            Tooltip { HintCard { message: root.action-label; } }
        }
    }
    field := TextField {
        x: root.settings-control ? 0px : -6px; width: parent.width - self.x;
        visible: root.editing; inline: !root.settings-control; clearable: false; field-name: root.field-name; type-size: root.type-size;
        submit(value) => { root.save(value); }
        cancel => { root.editing = false; root.changed-mode(); }
        blurred => { if root.editing { root.save(field.text); } }
    }
}


export component DialogFrame inherits FocusScope {
    in property <length> card-width: 348px;
    in property <string> title;
    in property <string> eyebrow;
    in property <bool> show-back;
    in property <bool> show-close: true;
    callback back();
    callback dismiss();
    accessible-role: groupbox;
    accessible-label: root.title;
    key-pressed(e) => {
        if e.text == Key.Escape { root.dismiss(); return accept; }
        return reject;
    }
    Rectangle { background: #080a0bbd; TouchArea { clicked => { root.dismiss(); } } }
    Rectangle {
        width: root.card-width; height: content.preferred-height;
        background: #202225; border-radius: 9px; border-color: #393c41; border-width: 1px;
        TouchArea {}
        content := VerticalLayout {
            padding: 17px; spacing: 12px;
            HorizontalLayout {
                height: root.eyebrow == "" ? 28px : 41px;
                spacing: 6px;
                if root.show-back: Action {
                    width: 26px; height: 28px; icon-only: true;
                    caption: @tr("Back"); glyph: @image-url("../assets/icon/back.svg");
                    invoked => { root.back(); }
                }
                VerticalLayout {
                    if root.eyebrow != "": Label { text: root.eyebrow; height: 16px; font-size: 12px; color: #a7abb2; }
                    Label { text: root.title; font-size: 19px; font-weight: 600; }
                }
                if root.show-close: Action {
                    width: 28px; height: 28px; caption: "×"; title-button: true;
                    accessible-label: @tr("Close");
                    invoked => { root.dismiss(); }
                }
            }
            @children
        }
    }
}

export component DialogActions inherits HorizontalLayout {
    height: 32px;
    spacing: 8px;
    alignment: end;
    @children
}

export component DialogButton inherits Action {
    height: 32px;
    filled: !root.primary && !root.icon-only;
    in property <bool> initial-focus;
    in property <bool> initial-focus-visible;
    init => { if root.initial-focus { root.focus-default(root.initial-focus-visible); } }
}

export component DialogTrigger inherits Action {
    in property <bool> dialog-open;
    callback open-dialog();
    private property <bool> restore-focus;
    private property <bool> return-outline;
    invoked => {
        root.return-outline = root.keyboard-focus-visible;
        root.open-dialog();
        root.restore-focus = root.dialog-open;
    }
    changed dialog-open => {
        if !root.dialog-open && root.restore-focus {
            root.restore-focus = false;
            root.focus-default(root.return-outline);
        }
    }
}

export component DialogScroll inherits Rectangle {
    clip: true;
    in property <length> height-limit: 260px;
    in property <bool> reserve-gutter: true;
    preferred-height: min(root.height-limit, items.preferred-height);
    height: self.preferred-height;
    property <length> overflow: max(0px, view.content-height - view.height);
    function scroll-to(offset: length) {
        view.content-y = -clamp(offset, 0px, root.overflow);
    }
    keys := FocusScope {
        focus-on-tab-navigation: root.overflow > 0px;
        key-pressed(event) => {
            if event.text == Key.UpArrow || event.text == Key.DownArrow {
                root.scroll-to(-view.content-y + (event.text == Key.UpArrow ? -16px : 16px));
                return accept;
            }
            return reject;
        }
    }
    if keys.has-focus: Rectangle {
        border-radius: 4px; border-width: 1px; border-color: #8c929a;
    }
    view := Flickable {
        x: 0; width: parent.width - (root.reserve-gutter ? 16px : 0px); height: parent.height;
        content-width: self.width;
        content-height: items.preferred-height;
        items := VerticalLayout {
            width: view.width; height: self.preferred-height; spacing: 8px;
            @children
        }
    }
    if root.reserve-gutter && root.overflow > 0px: track := TouchArea {
        x: parent.width - self.width; width: 12px; height: parent.height;
        property <length> grab-offset;
        property <length> travel: self.height - thumb.height;
        function seek(y: length) {
            root.scroll-to((y - self.grab-offset) / max(1px, self.travel) * root.overflow);
        }
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                self.grab-offset = self.mouse-y >= thumb.y && self.mouse-y <= thumb.y + thumb.height
                    ? self.mouse-y - thumb.y : thumb.height / 2;
                self.seek(self.mouse-y);
            }
        }
        moved => { if self.pressed { self.seek(self.mouse-y); } }
        scroll-event(e) => { root.scroll-to(-view.content-y - e.delta-y); return accept; }
        thumb := Rectangle {
            width: 4px; height: clamp(track.height * (view.height / view.content-height), 24px, track.height);
            y: track.travel * clamp(-view.content-y / max(1px, root.overflow), 0, 1);
            border-radius: 2px;
            background: track.pressed ? #bfec70 : track.has-hover ? #949aa2 : #686e76;
        }
    }
}

export component DialogError inherits DialogScroll {
    in property <string> text;
    height-limit: 60px;
    Label { text: root.text; color: #e99087; font-size: 12px; wrap: word-wrap; overflow: clip; }
}

export component CopyFeedback inherits Rectangle {
    width: 0px; height: 0px;
    out property <bool> active: expiry.running;
    out property <bool> success;
    property <duration> until;
    public function clear() { expiry.stop(); }
    public function show(ok: bool) {
        success = ok;
        until = animation-tick() + 2s;
        expiry.interval = 2s;
        expiry.start();
    }
    expiry := Timer {
        running: false; interval: 2s;
        triggered => {
            if root.until > animation-tick() { self.interval = root.until - animation-tick(); }
            else { self.stop(); }
        }
    }
}

export component ProgressRing inherits Rectangle {
    width: 18px; height: 18px;
    in property <color> ink: #bfec70;
    in property <bool> spinning: true;
    in property <float> fraction: 0.25;
    property <angle> start-angle: root.spinning ? mod(animation-tick() / 1ms, 1400) / 1400 * 360deg : 0deg;
    property <angle> end-angle: start-angle + fraction * 360deg;
    rim := Rectangle { width: 16.5px; height: self.width; border-radius: self.width / 2; border-width: 1.5px; border-color: root.ink;
        opacity: root.fraction < 1 ? 0.3 : 1; }
    if root.fraction > 0 && root.fraction < 1: Path {
        width: 18px; height: 18px; viewbox-width: 18; viewbox-height: 18;
        stroke: root.ink; stroke-width: rim.border-width;
        MoveTo { x: 9 + 7.5 * sin(root.start-angle); y: 9 - 7.5 * cos(root.start-angle); }
        ArcTo { radius-x: 7.5; radius-y: 7.5; sweep: true; large-arc: root.fraction > 0.5;
            x: 9 + 7.5 * sin(root.end-angle); y: 9 - 7.5 * cos(root.end-angle); }
    }
}

export component DialogStep inherits VerticalLayout {
    in property <string> caption;
    in property <string> failure;
    in property <bool> current;
    in property <bool> complete;
    private property <bool> failed: root.current && root.failure != "";
    HorizontalLayout {
        height: 25px; spacing: 8px;
        Rectangle {
            width: 18px;
            if root.current && !root.failed: ProgressRing {}
            if !root.current || root.failed: Label {
                horizontal-alignment: center;
                text: root.failed ? "×" : root.complete ? "✓" : "·";
                color: root.failed ? #e99087 : root.complete ? #bfec70 : #a7abb2;
            }
        }
        Label {
            text: root.caption;
            font-weight: root.current ? 600 : 400;
            color: root.current || root.complete ? #eff0f2 : #a7abb2;
        }
    }
    if root.failed: HorizontalLayout {
        padding-left: 26px;
        DialogError { text: root.failure; }
    }
}
