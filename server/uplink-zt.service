[Unit]
Description=Uplink test network controller and private ZeroTier root
After=network-online.target
Wants=network-online.target

[Service]
User=uplink-zt
Group=uplink-zt
ExecStart=/opt/uplink-zt/1.16.2/usr/sbin/zerotier-one -U /var/lib/uplink-zt
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/uplink-zt
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
