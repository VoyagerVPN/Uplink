[Unit]
Description=Uplink HTTPS client API backend
Requires=uplink-zt.service
After=uplink-zt.service network-online.target

[Service]
User=uplink-zt
Group=uplink-zt
WorkingDirectory=/opt/uplink-zt
EnvironmentFile=/etc/uplink-client-api.env
ExecStart=/usr/bin/python3 -E -s -B /opt/uplink-zt/client_api.py
StateDirectory=uplink-instance
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET
UMask=0077
Restart=on-failure

[Install]
WantedBy=multi-user.target
