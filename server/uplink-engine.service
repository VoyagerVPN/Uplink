[Unit]
Description=Uplink network engine
After=network-online.target uplink-rpc-guard.service
Requires=uplink-rpc-guard.service

[Service]
User=uplink-net
Group=uplink-net
WorkingDirectory=/opt/uplink
ExecStart=/usr/bin/python3 -E -s -B /opt/uplink/engine.py
StateDirectory=uplink-members uplink-engine
StateDirectoryMode=0700
EnvironmentFile=/etc/uplink-network.env
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077
Restart=on-failure

[Install]
WantedBy=multi-user.target

