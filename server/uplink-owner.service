[Unit]
Description=Uplink instance API
Requires=uplink-engine.service
After=uplink-engine.service

[Service]
User=uplink-net
Group=uplink-net
WorkingDirectory=/opt/uplink
ExecStart=/usr/bin/python3 -E -s -B -c "import instance; instance.serve()"
StateDirectory=uplink-members
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET
UMask=0077
